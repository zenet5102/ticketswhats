PORT=3000
WHATSAPP_PROTOCOL_TIMEOUT_MS=180000
# Dejar vacio para autodetectar Chrome/Edge instalado.
WHATSAPP_CHROME_PATH=

# Segunda app WhatsApp. Usa otra sesion local y otro puerto.
SECOND_APP_PORT=3001
SECOND_WHATSAPP_CLIENT_ID=bot-2
SECOND_APP_AUTH_COOKIE_NAME=wwebjs_second_session
SECOND_APP_JSON_LIMIT_MB=25
SECOND_APP_MAX_STORED_MEDIA_MB=15

# MySQL para los mensajes de la segunda app.
SECOND_APP_MYSQL_HOST=127.0.0.1
SECOND_APP_MYSQL_PORT=3306
SECOND_APP_MYSQL_USER=root
SECOND_APP_MYSQL_PASSWORD=
SECOND_APP_MYSQL_DATABASE=wwebjs_second
SECOND_APP_MYSQL_MESSAGES_TABLE=second_whatsapp_messages
SECOND_APP_MYSQL_QUEUE_TABLE=second_message_queue
SECOND_APP_MYSQL_PHANTOM_CLIENTS_TABLE=second_phantom_clients
SECOND_APP_MYSQL_CONNECTION_LIMIT=10
SECOND_APP_MYSQL_CREATE_DATABASE=true
SECOND_MESSAGE_QUEUE_INTERVAL_MINUTES=10
SECOND_MESSAGE_QUEUE_BATCH_SIZE=20
SECOND_MESSAGE_TEMPLATE=Hola {razon_social}, registramos deuda pendiente por {deuda}. Por favor comunicate con administracion para regularizarla.

# API Phantom. Autentificar es POST con action=autentificar&api_user=&api_pass=
# por URL. Consulta_Masiva_Datos es POST con action, JSON, Desc, Limit,
# Offset, BalanceCC, CompAdeudados y Estado por URL; token e ID_Desde/ID_Hasta
# van en body JSON.
# Acciones extra soportadas: Consultar_Disponibilidad_NAP con token por URL y
# Latitud, Longitud, DistanciaDrop por POST; Consulta_Cliente_Avanzada con
# token, JSON=1, IDA, InfoFTTH=1 e ImporteProductos=1 por URL.
PHANTOM_API_URL=https://api.ejemplo.com
PHANTOM_API_TIMEOUT_MS=15000
PHANTOM_API_USER=
PHANTOM_API_PASS=
PHANTOM_API_HEADERS={}
PHANTOM_API_TOKEN_PATHS=token,Token,access_token,accessToken,data.token,data.Token,data.access_token,resultado.token,result.token
PHANTOM_CONSULTA_ID_DESDE=1
PHANTOM_CONSULTA_ID_HASTA=999999999
PHANTOM_CONSULTA_DESC=1
PHANTOM_CONSULTA_LIMIT=10
PHANTOM_CONSULTA_OFFSET=0
PHANTOM_CONSULTA_BALANCE_CC=1
PHANTOM_CONSULTA_COMP_ADEUDADOS=1
PHANTOM_CONSULTA_ESTADO=Suspendido

# Login local. Los usuarios quedan guardados en SQLite.
# Estas claves solo se usan para sembrar la tabla si todavia esta vacia.
AUTH_SESSION_SECRET=cambiar-por-un-secreto-largo
AUTH_SESSION_HOURS=12
AUTH_ADMIN_PASSWORD=admin
AUTH_USUARIO_PASSWORD=usuario
# Alternativa avanzada para el seed inicial:
# AUTH_USERS_JSON={"admin":{"password":"admin","role":"admin","name":"Administrador"},"usuario":{"password":"usuario","role":"usuario","name":"Usuario"}}

# Respuesta automatica cuando alguien escribe y el chat no corresponde a ningun ticket.
TECHNICAL_VISIT_SUPPORT_PHONE=xxxx
NOTIFICATION_CHANNEL_REPLY=Este es un canal de notificaciones de visita tecnica. Para gestionar tu visita comunicate al numero {support_phone}.

# Endpoint que devuelve los tickets del dia o una lista general.
TICKETS_API_URL=https://YYY/XXX
TICKETS_API_METHOD=POST
TICKETS_API_BODY_FORMAT=json
TICKETS_API_ACTION=actionname
TICKETS_API_PERIOD_FIELD=periodo
TICKETS_API_PERIOD_START_DATE=
TICKETS_API_PERIOD_MONTHS_BACK=2
TICKETS_API_PERIOD_DAYS_FORWARD=1

# Endpoint para consultar datos/estado del ticket.
# Si no se define, usa TICKETS_API_URL. Con POST envia action + id en el body.
TICKET_STATUS_API_URL=https://
TICKET_STATUS_API_METHOD=POST
TICKET_STATUS_API_BODY_FORMAT=json
TICKET_STATUS_API_ACTION=

CLIENT_API_URL=https://
CLIENT_API_METHOD=POST
CLIENT_API_BODY_FORMAT=json
CLIENT_API_ACTION=
CLIENT_LOOKUP_TICKET_FIELD=
CLIENT_LOOKUP_METHOD=
CLIENT_LOOKUP_METHOD_FIELD=
CLIENT_LOOKUP_VALUE_FIELD=

# Nombres de campos enviados en el body POST.
TICKETS_API_ACTION_FIELD=action
TICKET_ID_BODY_FIELD=idtt

# Body extra opcional si la API requiere mas datos fijos.
TICKETS_API_BODY={}
TICKET_STATUS_API_BODY={}
CLIENT_API_BODY={}

# Autenticacion opcional.
TICKETS_API_TOKEN=
TICKETS_API_HEADERS={}
# Ejemplo si la API usa API key: TICKETS_API_HEADERS={"X-Api-Key":"valor"}

# Frecuencia de sincronizacion y actualizacion de estados.
TICKET_SYNC_INTERVAL_MINUTES=30

# Campos de la API. Dejar vacio si la API usa nombres comunes como id, start,
# delegacion, telefono y estado.
TICKET_ID_FIELD=IDTT
TICKET_DATE_FIELD=START
TICKET_START_FIELD=START
TICKET_CATEGORY_FIELD=Categoria
TICKET_DELEGACION_FIELD=Delegacion
TICKET_DELEGACION_PREFIXES=Cua,Cua
TICKET_PHONE_FIELD=Movil
TICKET_STATUS_FIELD=Estado
TICKET_EXCLUDED_CATEGORIES=

# Mensaje enviado al siguiente ticket cuando el anterior queda en proceso.
# Variables disponibles: {external_id}, {delegacion}, {hora}, {start},
# {previous_external_id}, {previous_hora}.
TICKET_MESSAGE_TEMPLATE=Hola, le informamos que nuestro tecnico esta proximo a llegar a su domicilio.

# DB local.
TICKETS_DB_PATH=./data/tickets.sqlite
AUTO_START_TICKET_JOBS=true
